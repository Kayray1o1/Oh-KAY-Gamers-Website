---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const sortByDate = (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const gamingPosts = (await getCollection('gaming')).sort(sortByDate);
const writingPosts = (await getCollection('writing')).sort(sortByDate);

const sections = [
	{
		slug: 'gaming',
		label: 'Gaming',
		blurb: 'Dev logs, game reviews, and behind-the-scenes from the studio.',
		posts: gamingPosts,
	},
	{
		slug: 'writing',
		label: 'Writing',
		blurb: 'Fiction, story craft, and the worlds behind the games.',
		posts: writingPosts,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog | Oh KAY Gamers" description="Two corners of the same world — dev logs from the games, and the fiction behind them." />
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<div class="blog-header">
				<p class="eyebrow">Oh KAY Gamers</p>
				<h1>Blog</h1>
				<p class="subtitle">Two corners of the same world. Pick your side.</p>
			</div>

			<div class="section-grid">
				{sections.map((section) => {
					const latest = section.posts[0];
					return (
						<a href={`/blog/${section.slug}/`} class="section-card">
							{latest?.data.heroImage && (
								<div class="section-thumb">
									<img src={latest.data.heroImage.src} alt={latest.data.title} />
								</div>
							)}
							<div class="section-body">
								<p class="section-eyebrow">{section.posts.length} {section.posts.length === 1 ? 'post' : 'posts'}</p>
								<h2 class="section-title">{section.label}</h2>
								<p class="section-blurb">{section.blurb}</p>
								{latest ? (
									<p class="section-latest">
										Latest: <span>{latest.data.title}</span>
										<span class="section-latest-date"><FormattedDate date={latest.data.pubDate} /></span>
									</p>
								) : (
									<p class="section-latest section-empty">No posts yet — coming soon.</p>
								)}
								<span class="section-cta">Enter {section.label} →</span>
							</div>
						</a>
					);
				})}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-page {
		width: 920px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0 1em 5em;
	}

	.blog-header {
		text-align: center;
		padding: 4em 1em 3em;
		border-bottom: 1px solid rgba(139,0,0,0.15);
		margin-bottom: 3em;
	}

	.eyebrow {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 0.72em;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 0.8em;
	}

	.blog-header h1 {
		font-size: 3.2em;
		margin: 0 0 0.4em;
		text-shadow: 0 0 40px rgba(139,0,0,0.2);
	}

	.subtitle {
		font-size: 1em;
		color: var(--gray-text);
		margin: 0;
		font-style: italic;
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.8em;
	}

	.section-card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--bg-card);
		border: 1px solid rgba(139,0,0,0.15);
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
	}

	.section-card:hover {
		border-color: rgba(139,0,0,0.45);
		box-shadow: 0 6px 30px rgba(139,0,0,0.14);
		transform: translateY(-3px);
	}

	.section-thumb {
		width: 100%;
		height: 200px;
		overflow: hidden;
	}

	.section-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s;
	}

	.section-card:hover .section-thumb img {
		transform: scale(1.04);
	}

	.section-body {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		padding: 1.8em;
	}

	.section-eyebrow {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 0.65em;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0;
	}

	.section-title {
		font-size: 1.9em;
		margin: 0;
		color: var(--white);
	}

	.section-card:hover .section-title {
		color: var(--accent);
	}

	.section-blurb {
		font-size: 0.92em;
		color: var(--gray-text);
		line-height: 1.6;
		margin: 0;
	}

	.section-latest {
		font-size: 0.82em;
		color: var(--gray-text);
		margin: 0.6em 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}

	.section-latest span:first-child {
		color: var(--white);
	}

	.section-latest-date {
		opacity: 0.55;
		font-size: 0.92em;
	}

	.section-empty {
		font-style: italic;
		opacity: 0.7;
	}

	.section-cta {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 0.72em;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin-top: 1em;
		font-weight: 700;
	}

	@media (max-width: 680px) {
		.section-grid { grid-template-columns: 1fr; }
	}
</style>
